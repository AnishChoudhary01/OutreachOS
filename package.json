{
  "name": "outreachos",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch apps/backend/src/server.ts",
    "dev:worker": "tsx watch apps/backend/src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "set RUN_INTEGRATION_TESTS=true&& vitest run apps/backend/tests/integration.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.17.1", "bullmq": "^5.58.5", "dotenv": "^17.2.2", "express": "^5.1.0", "ioredis": "^5.7.0", "nodemailer": "^7.0.6", "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.3", "@types/node": "^24.5.2", "@types/nodemailer": "^7.0.1", "prisma": "^6.17.1", "tsx": "^4.20.5", "typescript": "^5.9.2", "vitest": "^3.2.4"
  }
}

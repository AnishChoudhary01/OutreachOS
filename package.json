{
  "name": "outreachos",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch apps/backend/src/server.ts",
    "dev:frontend": "vite --config apps/frontend/vite.config.ts",
    "dev:worker": "tsx watch apps/backend/src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "build:frontend": "vite build --config apps/frontend/vite.config.ts",
    "typecheck:frontend": "tsc -p apps/frontend/tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "set RUN_INTEGRATION_TESTS=true&& vitest run apps/backend/tests/integration.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy"
    ,"lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.19.1", "@prisma/client": "^6.17.1", "@bull-board/api": "^6.15.0", "@bull-board/express": "^6.15.0", "axios": "^1.8.4", "bullmq": "^5.58.5", "cors": "^2.8.5", "dotenv": "^17.2.2", "express": "^5.1.0", "ioredis": "^5.7.0", "nodemailer": "^7.0.6", "react": "^19.1.1", "react-dom": "^19.1.1", "react-router-dom": "^7.9.1", "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17", "@types/express": "^5.0.3", "@types/node": "^24.5.2", "@types/nodemailer": "^7.0.1", "@types/react": "^19.1.10", "@types/react-dom": "^19.1.9", "@vitejs/plugin-react": "^4.3.4", "autoprefixer": "^10.4.21", "postcss": "^8.5.6", "prisma": "^6.17.1", "tailwindcss": "^3.4.17", "tsx": "^4.20.5", "typescript": "^5.9.2", "vite": "^6.3.5", "vitest": "^3.2.4"
  }
}
